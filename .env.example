# pumpkin production/runtime configuration
#
# For browser development, same-origin defaults are used.
# Native production releases MUST be built with the two VITE_* endpoints below.
# Do not point them to an authenticated AI Studio preview URL.

VITE_API_BASE_URL="https://your-public-api.example.com"
VITE_WS_URL="wss://your-public-api.example.com/ws"

# Public web origin used by the server CORS allowlist.
APP_URL="https://your-public-web.example.com"

# Optional TURN relay for users behind restrictive NAT/firewalls.
TURN_URL="turn:turn.example.com:3478"
TURN_USERNAME=""
TURN_CREDENTIAL=""
